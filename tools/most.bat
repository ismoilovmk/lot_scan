@echo off
chcp 65001 >nul
title Мост для бота лотов - не закрывайте это окно
rem Мост: этот компьютер даёт серверу бота свой интернет для сайта new.cooperation.uz.
rem Сайт не отвечает дата-центрам, а с обычного интернета в Узбекистане открывается.
rem
rem Что нужно один раз: ключ к серверу и запись "Host uz_vps" в файле %USERPROFILE%\.ssh\config
rem (проверка: команда "ssh uz_vps" должна входить на сервер без пароля).
rem
rem Пока это окно открыто, бот проверяет cooperation.uz. Закрыли окно или выключили компьютер -
rem бот эту площадку просто пропускает, остальные работают как обычно.
rem Портов несколько: после обрыва связи прежний порт на сервере освобождается не сразу.

echo Мост для бота лотов. Не закрывайте это окно: пока оно открыто, бот видит cooperation.uz.
echo.
:again
for %%p in (1080 1081 1082 1083) do (
  echo Подключаюсь к серверу, порт %%p ...
  ssh -N -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -R %%p uz_vps
)
echo Связи с сервером нет. Повторю через 20 секунд.
timeout /t 20 /nobreak >nul
goto again
