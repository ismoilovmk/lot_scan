# Скопируйте этот файл в .env и впишите свои значения.
# Токен выдаёт @BotFather в Telegram после команды /newbot
TELEGRAM_BOT_TOKEN=
# ID чата или группы, куда слать лоты (свой ID покажет бот @userinfobot)
TELEGRAM_CHAT_ID=
# ID чата для лотов на перевозку грузов. Пока пусто, бот эти лоты не ищет
TELEGRAM_CHAT_ID_TRANSPORT=
